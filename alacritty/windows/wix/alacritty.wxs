<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
   <Package Name="Termust" UpgradeCode="0df08c63-dc80-5db7-87b4-afdedb8822e3" Language="1033" Codepage="1252" Version="0.18.0-dev" Manufacturer="Termust" InstallerVersion="200">
      <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
      <Icon Id="TermustIco" SourceFile=".\extra\logo\termust.ico" />
      <WixVariable Id="WixUILicenseRtf" Value=".\alacritty\windows\wix\license.rtf" />
      <Property Id="ARPPRODUCTICON" Value="TermustIco" />
      <MediaTemplate EmbedCab="yes" />
      <ui:WixUI Id="WixUI_Minimal" />
      <Feature Id="ProductFeature" Title="ConsoleApp" Level="1">
         <ComponentRef Id="TermustExe" />
         <ComponentRef Id="TermustShortcut" />
         <ComponentRef Id="ModifyPathEnv" />
         <ComponentRef Id="ContextMenu" />
         <ComponentRef Id="ContextMenuFolder" />
      </Feature>
      <!-- Application binaries -->
      <DirectoryRef Id="TermustProgramFiles">
         <Component Id="TermustExe">
            <File Id="TermustExeFile" Source=".\target\release\termust.exe" Name="termust.exe" KeyPath="yes" />
         </Component>
      </DirectoryRef>
      <DirectoryRef Id="TermustProgramMenu">
         <!-- Application shortcut -->
         <Component Id="TermustShortcut" Guid="94eefb68-4a60-54e3-9089-9861f7eb264a">
            <Shortcut Id="TermustShortcutFile" Name="Termust" Description="A cross-platform, GPU-accelerated terminal emulator" Target="[TermustProgramFiles]termust.exe" />
            <RemoveFolder Id="TermustProgramMenu" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Termust" Name="installed" Type="integer" Value="1" KeyPath="yes" />
         </Component>
      </DirectoryRef>
      <DirectoryRef Id="TermustProgramFiles">
         <!-- Add to PATH -->
         <Component Id="ModifyPathEnv" Guid="b58142d9-3612-5804-8f6e-351e2659ba02" KeyPath="yes">
            <Environment Id="PathEnv" Value="[TermustProgramFiles]" Name="PATH" Permanent="no" Part="first" Action="set" System="yes" />
         </Component>
      </DirectoryRef>
      <StandardDirectory Id="ProgramFiles64Folder">
         <Directory Id="TermustProgramFiles" Name="Termust" />
      </StandardDirectory>
      <StandardDirectory Id="ProgramMenuFolder">
         <Directory Id="TermustProgramMenu" Name="Termust" />
      </StandardDirectory>
      <!-- Add context menu -->
      <Component Id="ContextMenu" Guid="6f6151b8-7ccb-5888-a66a-abd34e65f44d" Directory="TARGETDIR">
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\Open Termust here\command">
            <RegistryValue Type="string" Value='[TermustProgramFiles]termust.exe --working-directory "%v"' KeyPath="yes" />
         </RegistryKey>
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\Open Termust here">
            <RegistryValue Type="string" Name="Icon" Value="[TermustProgramFiles]termust.exe" />
         </RegistryKey>
      </Component>
      <Component Id="ContextMenuFolder" Guid="088e8f34-030b-5187-b342-b8bcdde1a573" Directory="TARGETDIR">
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\Open Termust here\command">
            <RegistryValue Type="string" Value='[TermustProgramFiles]termust.exe --working-directory "%v"' KeyPath="yes" />
         </RegistryKey>
         <RegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\Open Termust here">
            <RegistryValue Type="string" Name="Icon" Value="[TermustProgramFiles]termust.exe" />
         </RegistryKey>
      </Component>
   </Package>
</Wix>
